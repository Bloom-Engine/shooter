{
  "name": "bloom-shooter",
  "version": "0.1.0",
  "license": "MIT",
  "main": "src/main.ts",
  "scripts": {
    "props": "bun tools/build-props.ts && bun tools/build-terrain.ts",
    "assets": "bun tools/build-props.ts && bun tools/build-terrain.ts && bun tools/build-weapons.ts && bun tools/build-vfx-textures.ts && bun tools/build-terrain-textures.ts",
    "audio": "bun tools/convert-audio.ts",
    "build": "PERRY_LLVM_INPROCESS=0 perry compile src/main.ts -o main",
    "dev": "PERRY_LLVM_INPROCESS=0 perry compile src/main.ts -o main && ./main"
  },
  "dependencies": {
    "bloom": "file:../engine/"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "bloom",
        "bloom/core",
        "bloom/scene",
        "bloom/physics",
        "bloom/world",
        "bloom/models",
        "bloom/textures",
        "bloom/audio",
        "bloom/vfx"
      ]
    }
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0"
  }
}
