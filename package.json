{
  "name": "bloom-shooter",
  "version": "0.1.0",
  "main": "src/main.ts",
  "scripts": {
    "convert": "bun tools/convert-assets.ts",
    "props": "bun tools/build-props.ts && bun tools/build-terrain.ts",
    "assets": "bun tools/build-props.ts && bun tools/build-terrain.ts",
    "build": "perry compile src/main.ts -o main",
    "dev": "perry compile src/main.ts -o main && ./main"
  },
  "dependencies": {
    "bloom": "file:../engine/"
  },
  "perry": {
    "allow": {
      "nativeLibrary": ["bloom", "bloom/core", "bloom/scene", "bloom/physics", "bloom/world"]
    }
  }
}
