node_modules/
package-lock.json
target/
dist/
*.o
/main
.DS_Store

# iOS app bundles (the .app carries a full copy of assets/ — ~160 MB)
build/
*.app/

# Converted-from-Unvanquished source tree (huge, re-cloneable)
vendor/
tools/.cache/

# Test + screenshot artefacts
shooter_*.png
shooter_selftest_*.png
tools/.testout/

# Windows build + run artefacts
main.exe
main.lib
.perry-cache/
_compile.log
_gamepid.txt
_run_err.txt
_run_out.txt

# lld /DEBUG output from perry compile --debug-symbols
main.pdb
# perry/lld intermediate files left behind when a relink races a stale handle
*.tmp0

# F12 native screenshots (debug captures)
screenshot_*.png

# Editor scratch state (recent projects, layout)
.bloom-editor/

# Play-in-editor scratch level (editor writes it, game loads it, nobody commits it)
assets/worlds/__playtest.world.json
# tools/paint-test-world.ts fixture
assets/worlds/__painttest.world.json

# Player's saved settings, written by the game at runtime. Never ship one:
# a stale (or corrupt) settings.json is read at startup and Perry's JSON.parse
# ABORTS the process on bad input.
settings.json
level.txt

# Raw Suno renders the mastering pipeline reads (tools/music-master.ts).
# 94 MB of untrimmed WAV masters — keep them archived OUTSIDE the repo; the
# shipped OGGs are what the game loads.
assets/music/src/
# music-master.ts writes WAV; encode-music.ts turns them into the shipped OGGs
# and removes these intermediates.
assets/music/*.wav

# ShareTextures packs (leaf atlases for prop_tree2/3 rebuilds). NOT plain CC0:
# their license forbids redistribution in collections and automated downloads,
# so they must not be committed — download manually (see
# assets/textures/external/SOURCES.md); build-props.ts falls back cleanly
# without them.
assets/textures/external/robinia/
assets/textures/external/platanus/

# DXC runtime for SM6.5 / hardware ray query on DX12 (wgpu DynamicDxc loads
# them from beside the exe; silent FXC fallback without them). Fetch with the
# engine's tools/fetch-dxc.ps1 — Microsoft-redistributable, but a binary
# artefact, not source.
dxcompiler.dll
dxil.dll
